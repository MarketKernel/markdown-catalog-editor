{
  "manifest_version": 3,
  "name": "Markdown Knowledge Base",
  "description": "Sends what you select on a web page to your Markdown notes on disk: the default note or one you pick. Edit them in the side panel.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Send to Markdown", "default_popup": "popup.html" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "activeTab", "scripting", "contextMenus", "storage", "offscreen"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+M" } }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
