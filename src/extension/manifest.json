{
  "manifest_version": 3,
  "name": "Send to Markdown",
  "description": "Sends a web page, a selection, a link or an image to a Markdown note in a folder on your disk. Edit it in the side panel.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Send the page or the selection to Markdown" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "activeTab", "scripting", "contextMenus", "storage"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+M" } }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
